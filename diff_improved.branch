@@ -0,0 +1,36 @@
+{
+  "name": "@ui8kit/resta-dsl-dist",
+  "version": "0.1.0",
+  "private": true,
+  "type": "module",
+  "scripts": {
+    "dev": "vite",
+    "build": "vite build",
+    "typecheck": "tsc --noEmit",
+    "preview": "vite preview",
+    "generate:html": "ui8kit-generate html --cwd . --config dist.config.json",
+    "generate:styles": "ui8kit-generate styles --cwd . --config dist.config.json",
+    "generate:static": "ui8kit-generate static --cwd . --config dist.config.json"
+  },
+  "dependencies": {
+    "class-variance-authority": "^0.7.1",
+    "clsx": "^2.1.1",
+    "lucide-react": "^0.460.0",
+    "react": "^19.0.0",
+    "react-dom": "^19.0.0",
+    "react-router-dom": "^7.0.1",
+    "tailwind-merge": "^3.4.1"
+  },
+  "devDependencies": {
+    "@tailwindcss/postcss": "^4.1.18",
+    "@types/react": "^19.0.0",
+    "@types/react-dom": "^19.0.0",
+    "@types/node": "^22.13.10",
+    "@vitejs/plugin-react-swc": "^3.11.0",
+    "postcss": "^8.5.6",
+    "tailwindcss": "^4.1.18",
+    "typescript": "^5.8.0",
+    "vite": "^6.3.5",
+    "@ui8kit/generator": "workspace:*"
+  }
+}
