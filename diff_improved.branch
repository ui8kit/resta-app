+++ b/apps/react/fixtures/blog.json
@@ -0,0 +1,36 @@
+{
+  "title": "RestA Blog",
+  "subtitle": "News, events, and stories from our kitchen.",
+  "posts": [
+    {
+      "id": "post-spring-menu-2025",
+      "slug": "spring-menu-2025",
+      "title": "Spring Menu 2025",
+      "excerpt": "Discover our new seasonal dishes featuring spring produce.",
+      "body": "We're excited to introduce our spring menu. Highlights include asparagus risotto, lamb with mint pesto, and rhubarb tart. All dishes use locally sourced ingredients from our partner farms.",
+      "image": { "src": "", "alt": "Spring Menu 2025", "width": 0, "height": 0 },
+      "date": "2025-02-15T00:00:00Z",
+      "author": "Chef Marco"
+    },
+    {
+      "id": "post-wine-pairing-guide",
+      "slug": "wine-pairing-guide",
+      "title": "Wine Pairing Guide",
+      "excerpt": "How to pair wine with our signature dishes.",
+      "body": "Our sommelier shares tips: salmon pairs well with Sauvignon Blanc, beef tenderloin with Cabernet Sauvignon, and tiramisu with Moscato. Ask our staff for recommendations.",
+      "image": { "src": "", "alt": "Wine Pairing Guide", "width": 0, "height": 0 },
+      "date": "2025-02-01T00:00:00Z",
+      "author": "RestA Team"
+    },
+    {
+      "id": "post-sustainable-dining",
+      "slug": "sustainable-dining",
+      "title": "Our Commitment to Sustainable Dining",
+      "excerpt": "How we source and reduce waste.",
+      "body": "We partner with local farms, use seasonal ingredients, and compost food waste. Our seafood is sustainably sourced. We're working toward zero-waste kitchen operations by 2026.",
+      "image": { "src": "", "alt": "Our Commitment to Sustainable Dining", "width": 0, "height": 0 },
+      "date": "2025-01-20T00:00:00Z",
+      "author": "RestA Team"
+    }
+  ]
+}
