diff --git a/apps/react/index.html b/apps/react/index.html
new file mode 100644
index 0000000..34afb57
--- /dev/null
+++ b/apps/react/index.html
@@ -0,0 +1,29 @@
+<!DOCTYPE html>
+<html lang="en">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>RestA — Restaurant & Bar</title>
+    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64," />
+    <script>
+      (function() {
+        const stored = localStorage.getItem('resta-theme');
+        const dark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
+        if (dark) {
+          document.documentElement.classList.add('dark');
+          document.documentElement.style.colorScheme = 'dark';
+        } else {
+          document.documentElement.classList.remove('dark');
+          document.documentElement.style.colorScheme = 'light';
+        }
+      })();
+    </script>
+    <style>
+      #root[data-class="main-layout"]:has(> aside) { flex-direction: row; }
+    </style>
+  </head>
+  <body>
+    <div id="root" class="flex flex-col min-h-screen" data-class="main-layout"></div>
+    <script type="module" src="/src/main.tsx"></script>
+  </body>
+</html>
diff --git a/apps/react/package.json b/apps/react/package.json
new file mode 100644
index 0000000..8cf1569
