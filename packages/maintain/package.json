{
  "name": "@ui8kit/maintain",
  "version": "0.1.0",
  "description": "CLI maintenance toolkit for UI8Kit projects",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ui8kit/maintain"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "GUIDE.md"
  ],
  "bin": {
    "maintain": "./dist/cli.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "lint:boundaries": "oxlint --import-plugin .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ui8kit/generator": "^0.2.1",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^25.3.1"
  }
}
